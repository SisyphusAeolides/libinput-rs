#compdef libinput

_arguments -C \
  '(-h --help)'{-h,--help}'[show help]' \
  '(-V --version)'{-V,--version}'[show version]' \
  '1:command:(list-devices debug-events elan-recover analyze measure quirks record replay)' \
  '*::argument:->arguments'

case $words[2] in
  debug-events)
    _arguments '*--device[input event node]:device:_files -W /dev/input -g "event*"'
    ;;
  elan-recover)
    _arguments \
      '*--device[ELAN I2C device identifier]:identifier:' \
      '--all[recover all ELAN I2C controllers]' \
      '--affected-only[act only on affected ThinkPad P53 systems]' \
      '--quiet[suppress successful recovery output]'
    ;;
esac
