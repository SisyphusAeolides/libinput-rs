module Safety.ResourceLifecycle is
    type RestrictedFd: Linear;
    type Closed: Free;
    type UdevBackend: Free;
    type HotplugPermission: Linear;

    function acquire(): RestrictedFd;
    function reject(fd: RestrictedFd): Closed;
    function remove(fd: RestrictedFd): Closed;
    function udevBackend(): UdevBackend;
    function enableHotplug(backend: UdevBackend): HotplugPermission;
    function disableHotplug(permission: HotplugPermission): Unit;
end module.
