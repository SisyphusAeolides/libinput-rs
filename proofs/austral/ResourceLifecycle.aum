module body Safety.ResourceLifecycle is
    record RestrictedFd: Linear is
        marker: Unit;
    end;

    record Closed: Free is
        marker: Unit;
    end;

    record UdevBackend: Free is
        marker: Unit;
    end;

    record HotplugPermission: Linear is
        marker: Unit;
    end;

    function acquire(): RestrictedFd is
        return RestrictedFd(marker => nil);
    end;

    function reject(fd: RestrictedFd): Closed is
        let { marker: Unit } := fd;
        return Closed(marker => marker);
    end;

    function remove(fd: RestrictedFd): Closed is
        let { marker: Unit } := fd;
        return Closed(marker => marker);
    end;

    function udevBackend(): UdevBackend is
        return UdevBackend(marker => nil);
    end;

    function enableHotplug(backend: UdevBackend): HotplugPermission is
        let { marker: Unit } := backend;
        return HotplugPermission(marker => marker);
    end;

    function disableHotplug(permission: HotplugPermission): Unit is
        let { marker: Unit } := permission;
        return marker;
    end;
end module body.
